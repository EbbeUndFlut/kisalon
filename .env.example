# Vorlage: kopieren nach .env und Werte anpassen (.env wird nicht eingecheckt)

# Webserver
PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=schnittpunkt

# Salon-Bereich: scrypt-Hash des gemeinsamen Passworts.
# Neu erzeugen mit: npm run passwort-hash -- "neues Passwort"
# Der folgende Demo-Hash gehört zum Passwort: schnittpunkt-salon
SALON_PASSWORT_HASH=scrypt$f812f80b4e9cb5cf543a07a73b215903$9444e12afba9483fc530e1472fd9e512af299f432149bcb7d33f267d3fbbb0e19acb416dbec7d644657b3197add07f01a4d781bbe813625fb5095493c35c80e0
SALON_SITZUNG_STUNDEN=10

# Zeitzone des Salons
SALON_ZEITZONE=Europe/Berlin

# Bestätigungs-E-Mail (optional). Ohne SMTP_HOST wird die E-Mail in der Konsole ausgegeben.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_ABSENDER="Friseursalon Schnittpunkt <termine@schnittpunkt.example>"
OEFFENTLICHE_URL=http://localhost:3000
